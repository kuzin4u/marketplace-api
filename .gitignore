# ============================================================
# marketplace-api
#
# Репозиторий публичный: всё, что сюда попадёт, читается кем угодно
# и остаётся в истории даже после удаления файла. Поэтому секреты
# и персональные данные не должны попадать сюда ни при каких условиях.
# ============================================================

# --- секреты -------------------------------------------------
# Строки подключения к базе, JWT_SECRET, ключи API.
# Боевые значения живут в переменных окружения Render,
# локальные — в .env, который сюда не коммитится.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
service-account*.json

# --- персональные данные -------------------------------------
# dump-restore-verify.sh создаёт дамп с данными покупателей.
# Выгрузки из Google Sheets (задача 0.7) содержат их же.
*.dump
*.backup
*.sql.gz
*.tar.gz
counts-*.txt
diff-*.txt
restore-*.log

# Табличные выгрузки. Если понадобится закоммитить безопасную
# фикстуру — снять исключение точечно:
#   !test/fixtures/sample.csv
*.csv
*.tsv
*.xlsx
*.xls
!ops/code-map.tsv

# --- производные файлы ---------------------------------------
# code-map.html собирается из ops/code-map.tsv генератором
# и живёт в пуле документов, а не здесь. Две версии одного
# содержимого неизбежно разойдутся.
code-map.html

# --- зависимости и сборка ------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
dist/
build/
coverage/

# --- Python (ops/render-code-map.py) -------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- окружение разработчика ----------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- временное -----------------------------------------------
*.log
*.tmp
tmp/
.cache/
